# HarmonIQ backend environment variables.
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.

# --- Django -----------------------------------------------------------------
# Required in production (DEBUG=False). Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# False in production. Locally keep it True.
DEBUG=True

# Comma-separated hostnames the backend answers to.
# Local:   ALLOWED_HOSTS=localhost,127.0.0.1
# Prod:    ALLOWED_HOSTS=<cloud-run-host>,<custom-domain>
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend origins -------------------------------------------------------
# Comma-separated origins allowed to send credentialed requests (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated origins Django will trust for unsafe (POST/PUT/DELETE)
# requests. Keep in sync with CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the Spotify OAuth callback sends the browser back to.
# Local:   FRONTEND_URL=http://localhost:5173
# Prod:    FRONTEND_URL=https://<frontend-domain>
FRONTEND_URL=http://localhost:5173

# --- Spotify OAuth ----------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered in the Spotify developer dashboard.
# Local:   http://127.0.0.1:8000/api/users/spotify/callback/
# Prod:    https://<cloud-run-host>/api/users/spotify/callback/
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/users/spotify/callback/

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty locally to keep using SQLite (db.sqlite3).
# Production: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional query parameters are passed to the driver, e.g. ?sslmode=require
DATABASE_URL=
